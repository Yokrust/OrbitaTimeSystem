{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal de ORBTIME",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "opener:default",
    "notification:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "$DOCUMENT/ORBTIME" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "$DOCUMENT/ORBTIME/*" }] }
  ]
}
