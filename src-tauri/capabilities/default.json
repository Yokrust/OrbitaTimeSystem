{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal de ORBTIME",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$DOCUMENT/ORBTIME" }] },
    "notification:default",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/ORBTIME" }, { "path": "$DOCUMENT/ORBTIME" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/ORBTIME/dia-actual.json" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$APPDATA/ORBTIME/dia-actual.json" },
        { "path": "$DOCUMENT/ORBTIME/ORBTIME_*.csv" },
        { "path": "$DOCUMENT/ORBTIME/ORBTIME_*.json" }
      ]
    }
  ]
}
